<!DOCTYPE html> 
<html lang="en"> 
<head> 
<meta charset="UTF-8"> 
<meta name="viewport" content="width=device-width,initial-scale=1"> <title>Online Shopping Billing System</title> 
<style> 
body{ 
font-family:Arial; 
background:#eef5ff; 
padding:40px; 
} 
.container{ 
max-width:700px; 
margin:auto; 
background:white; 
padding:25px; 
border-radius:10px; 
box-shadow:0 0 15px gray;
} 
h2{ 
text-align:center; color:#0b5394; 
} 
label{ 
font-weight:bold; } 
input,select{ 
width:100%; 
padding:10px; 
margin-top:5px; margin-bottom:15px; } 
button{ 
width:100%; 
padding:12px; 
background:#0b5394; color:white; 
border:none; 
font-size:18px; cursor:pointer; } 
button:hover{ 
background:#073763; } 
#bill{ 
margin-top:25px; background:#f4f4f4; padding:20px; 
border-radius:8px; } 
</style>
</head> 
<body> 
<div class="container"> 
<h2>Online Shopping Billing System</h2> 
<label>Customer Name</label> 
<input type="text" id="name"> 
<label>Mobile Number</label> 
<input type="tel" id="mobile"> 
<label>Invoice Number</label> 
<input type="text" id="invoice"> 
<label>Product Name</label> 
<input type="text" id="product"> 
<label>Quantity (Kg)</label> 
<input type="number" id="qty"> 
<label>Rate per Kg (₹)</label> <input type="number" id="rate"> 
<label>Discount (%)</label> 
<input type="number" id="discount"> 
<label>GST (%)</label> 
<input type="number" id="gst"> 
<label>Packing Charges (₹)</label> <input type="number" id="packing"> 
<label>Payment Mode</label> 
<select id="payment"> 
<option>Cash</option>
<option>Card</option> 
<option>UPI</option> 
</select> 
<label>Membership</label> 
<select id="member"> 
<option>No</option> 
<option>Yes</option> 
</select> 
<button onclick="calculateBill()">Generate Bill</button> <div id="bill"></div> 
</div> 
<script> 
function calculateBill(){ 
let name=document.getElementById("name").value; 
let mobile=document.getElementById("mobile").value; let invoice=document.getElementById("invoice").value; let product=document.getElementById("product").value; 
let qty=Number(document.getElementById("qty").value); let rate=Number(document.getElementById("rate").value); let discount=Number(document.getElementById("discount").value); let gst=Number(document.getElementById("gst").value); let packing=Number(document.getElementById("packing").value); 
let payment=document.getElementById("payment").value; let member=document.getElementById("member").value; 
let total=qty*rate; 
let discountAmount=(total*discount)/100; 
let subtotal=total-discountAmount;
let gstAmount=(subtotal*gst)/100; 
let finalBill=subtotal+gstAmount+packing; if(member=="Yes"){ 
finalBill=finalBill-100; 
} 
document.getElementById("bill").innerHTML=` <h3>Invoice</h3> 
<b>Customer :</b> ${name}<br> 
<b>Mobile :</b> ${mobile}<br> 
<b>Invoice :</b> ${invoice}<br> 
<b>Product :</b> ${product}<br> 
<b>Quantity :</b> ${qty} Kg<br> 
<b>Rate :</b> ₹${rate}<br> 
<b>Total :</b> ₹${total.toFixed(2)}<br> <b>Discount :</b> ₹${discountAmount.toFixed(2)}<br> <b>GST :</b> ₹${gstAmount.toFixed(2)}<br> <b>Packing :</b> ₹${packing}<br> 
<b>Payment :</b> ${payment}<br> 
<b>Membership :</b> ${member}<br> 
<hr> 
<h2>Final Bill : ₹${finalBill.toFixed(2)}</h2> `; 
} 
</script> 
</body> 
</html>
