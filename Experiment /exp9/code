<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Theme Settings Demo</title>
    <style>
        /* Base Variables and Layout */
        :root {
            --bg-color: #f5f3ff;
            --text-color: #312e51;
            --card-bg: #ffffff;
            --button-bg: #ede9fe;
            --button-text: #4338ca;
            --button-border: #c4b5fd;
            --border-color: #ddd6fe;
            --accent-color: #7c3aed;
        }

        /* Dark Theme Modifiers */
        [data-theme="dark"] {
            --bg-color: #171329;
            --text-color: #f5f3ff;
            --card-bg: #241c3d;
            --button-bg: #35275a;
            --button-text: #ede9fe;
            --button-border: #5b21b6;
            --border-color: #4c3b70;
        }

        body {
            font-family: system-ui, -apple-system, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 24px 20px;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
            box-sizing: border-box;
            transition: background-color 0.3s ease, color 0.3s ease;
            background-image: radial-gradient(circle at top left, rgba(124, 58, 237, .14), transparent 38%);
        }

        /* Highly visible layout design matching presentation slides */
        .theme-card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            padding: 34px;
            border-radius: 24px;
            text-align: center;
            box-shadow: 0 20px 45px rgba(76, 29, 149, 0.14);
            width: 100%;
            max-width: 480px;
        }

        h2 {
            margin-top: 0;
            font-size: 32px;
            letter-spacing: -1px;
            margin-bottom: 10px;
        }

        p {
            font-size: 17px;
            margin-bottom: 25px;
            font-weight: 500;
        }

        select {
            padding: 14px 18px;
            font-size: 16px;
            margin-bottom: 30px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            background-color: var(--card-bg);
            color: var(--text-color);
            cursor: pointer;
            width: 100%;
            max-width: 100%;
            font-weight: bold;
            text-align: center;
        }

        .button-group {
            display: flex;
            gap: 12px;
            flex-direction: row;
            margin-bottom: 20px;
        }

        button {
            padding: 13px 16px;
            font-size: 15px;
            font-weight: 600;
            border: 1px solid var(--button-border);
            border-radius: 12px;
            background-color: var(--button-bg);
            color: var(--button-text);
            cursor: pointer;
            transition: transform 0.2s ease, background-color 0.2s ease;
            flex: 1;
        }

        button:hover {
            background-color: var(--accent-color);
            color: white;
            transform: translateY(-2px);
        }

        /* Action-specific styling variants */
        .clear-btn {
            background-color: transparent;
            color: #ef4444;
            border: 1px dashed #f87171;
            border-radius: 12px;
            margin-bottom: 25px;
        }

        .clear-btn:hover {
            background-color: #fef2f2;
            border-color: #ef4444;
        }

        /* Large Status Feedback Text */
        .status-message {
            font-size: 15px;
            font-weight: 600;
            min-height: 28px;
            padding: 10px;
            border-radius: 6px;
            color: var(--accent-color);
        }
    </style>
</head>
<body>

    <div class="theme-card">
        <h2>Theme Settings</h2>
        <p>Select your preferred theme:</p>
        
        <select id="themeSelect">
            <option value="light">Light</option>
            <option value="dark">Dark</option>
        </select>

        <div class="button-group">
            <button id="saveLocalBtn">Save using localStorage</button>
            <button id="saveSessionBtn">Save using sessionStorage</button>
        </div>

        <button id="clearBtn" class="clear-btn">Clear Preferences</button>

        <div id="statusMsg" class="status-message"></div>
    </div>

    <script>
        const themeSelect = document.getElementById('themeSelect');
        const saveLocalBtn = document.getElementById('saveLocalBtn');
        const saveSessionBtn = document.getElementById('saveSessionBtn');
        const clearBtn = document.getElementById('clearBtn');
        const statusMsg = document.getElementById('statusMsg');

        function applyTheme(theme) {
            if (theme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
                themeSelect.value = 'dark';
            } else {
                document.documentElement.removeAttribute('data-theme');
                themeSelect.value = 'light';
            }
        }

        // Initialization
        const savedSessionTheme = sessionStorage.getItem('theme');
        const savedLocalTheme = localStorage.getItem('theme');

        if (savedSessionTheme) {
            applyTheme(savedSessionTheme);
            statusMsg.textContent = "Theme saved using sessionStorage.";
        } else if (savedLocalTheme) {
            applyTheme(savedLocalTheme);
            statusMsg.textContent = "Theme saved using localStorage.";
        }

        // Dropdown dynamic update
        themeSelect.addEventListener('change', () => {
            applyTheme(themeSelect.value);
        });

        // Local Storage
        saveLocalBtn.addEventListener('click', () => {
            const selectedTheme = themeSelect.value;
            localStorage.setItem('theme', selectedTheme);
            sessionStorage.removeItem('theme'); 
            statusMsg.textContent = `Theme saved using localStorage.`;
        });

        // Session Storage
        saveSessionBtn.addEventListener('click', () => {
            const selectedTheme = themeSelect.value;
            sessionStorage.setItem('theme', selectedTheme);
            localStorage.removeItem('theme'); 
            statusMsg.textContent = `Theme saved using sessionStorage.`;
        });

        // Reset App
        clearBtn.addEventListener('click', () => {
            localStorage.removeItem('theme');
            sessionStorage.removeItem('theme');
            applyTheme('light');
            statusMsg.textContent = "Preferences cleared.";
        });
    </script>
</body>
</html>
