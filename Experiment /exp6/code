<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Text Email Analyzer</title>
  <style>
    :root{
      --bg0:#fbf2e8;        /* light brown */
      --bg1:#f3e4d2;
      --card:rgba(255,255,255,.78);
      --card2:rgba(255,255,255,.62);

      --text:#2b1a10;
      --muted:#6b4b36;

      --line: rgba(43,26,16,.10);
      --shadow: 0 20px 55px rgba(43,26,16,.10);

      --accent:#8a4b2a;    /* coffee */
      --accent2:#6f3a1f;

      --primary1:#b56a2f;  /* caramel */
      --primary2:#8a4b2a;

      --good:#1a9a53;
      --bad:#d62b3a;

      --radius:18px;
    }

    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
      color:var(--text);
      background:
        radial-gradient(900px 540px at 15% -10%, rgba(181,106,47,.25), transparent 55%),
        radial-gradient(700px 480px at 95% 0%, rgba(138,75,42,.18), transparent 60%),
        linear-gradient(180deg, var(--bg0), var(--bg1));
    }

    .app{
      max-width:1120px;
      margin: 26px auto;
      padding: 0 16px 40px;
    }

    .topbar{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:14px;
      margin-bottom:16px;
    }

    .brand{
      display:flex;
      gap:12px;
      align-items:center;
    }

    .logo{
      width:46px;height:46px;border-radius:14px;
      background: linear-gradient(135deg, rgba(181,106,47,.28), rgba(138,75,42,.10));
      border:1px solid rgba(138,75,42,.18);
      box-shadow: 0 16px 40px rgba(138,75,42,.12);
      display:grid; place-items:center;
      font-weight:950;
      user-select:none;
    }

    .title{
      font-weight:950;
      letter-spacing:.2px;
      font-size:18px;
      line-height:1.2;
    }
    .subtitle{
      margin-top:3px;
      color:var(--muted);
      font-size:13px;
      font-weight:650;
    }

    .statusPill{
      display:flex;
      align-items:center;
      gap:10px;
      padding:10px 12px;
      border-radius:999px;
      background: rgba(255,255,255,.68);
      border: 1px solid var(--line);
      box-shadow: 0 12px 26px rgba(43,26,16,.06);
      user-select:none;
      white-space:nowrap;
    }
    .dot{
      width:10px;height:10px;border-radius:50%;
      background: rgba(26,154,83,.95);
      box-shadow: 0 0 0 6px rgba(26,154,83,.12);
    }
    .statusText{
      font-weight:800;
      color:var(--muted);
      font-size:13px;
    }

    .grid{
      display:grid;
      grid-template-columns: 1fr 1.12fr;
      gap:14px;
    }
    @media (max-width: 980px){
      .grid{grid-template-columns:1fr}
    }

    .panel{
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow:hidden;
    }

    .panelHeader{
      padding:14px 16px;
      border-bottom: 1px solid rgba(43,26,16,.08);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      background: linear-gradient(180deg, rgba(255,255,255,.6), rgba(255,255,255,.35));
    }

    .panelHeader h2{
      margin:0;
      font-size:15px;
      letter-spacing:.2px;
      font-weight:950;
    }
    .panelHeader .small{
      color:var(--muted);
      font-size:12.5px;
      font-weight:700;
    }

    .panelBody{padding:16px}

    textarea{
      width:100%;
      min-height: 240px;
      resize: vertical;
      border-radius: 14px;
      border: 1px solid rgba(43,26,16,.14);
      background: rgba(255,255,255,.86);
      padding: 12px;
      outline:none;
      font-size:14px;
      line-height:1.5;
      color:var(--text);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.55);
    }
    textarea:focus{
      border-color: rgba(181,106,47,.55);
      box-shadow: 0 0 0 4px rgba(181,106,47,.18);
    }

    .controls{
      display:flex;
      gap:10px;
      margin-top:12px;
      flex-wrap:wrap;
    }

    .btn{
      border:none;
      cursor:pointer;
      border-radius: 12px;
      padding: 11px 14px;
      font-weight:900;
      font-size:14px;
      color:#27160f;
      transition: transform .06s ease, filter .15s ease, box-shadow .15s ease;
      user-select:none;
      box-shadow: 0 14px 32px rgba(43,26,16,.08);
    }
    .btn:active{transform: translateY(1px)}
    .btn.primary{
      background: linear-gradient(135deg, rgba(181,106,47,.98), rgba(138,75,42,.96));
      color:#fff;
      box-shadow: 0 16px 38px rgba(138,75,42,.18);
    }
    .btn.primary:hover{filter: brightness(1.03)}
    .btn.ghost{
      background: rgba(255,255,255,.65);
      border: 1px solid rgba(43,26,16,.12);
      color: var(--accent2);
      box-shadow: none;
    }
    .btn.ghost:hover{filter: brightness(1.02)}

    .toggles{
      display:flex;
      gap:14px;
      flex-wrap:wrap;
      margin-top:12px;
    }
    .toggle{
      display:flex; align-items:center; gap:10px;
      padding: 8px 10px;
      border-radius: 12px;
      border:1px dashed rgba(43,26,16,.16);
      background: rgba(255,255,255,.55);
      user-select:none;
    }
    .toggle input{width:16px;height:16px; accent-color: var(--accent2);}

    .foot{
      margin-top:12px;
      color:var(--muted);
      font-size:12.5px;
      font-weight:700;
    }
    .inlineCode{
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      background: rgba(43,26,16,.06);
      border:1px solid rgba(43,26,16,.10);
      padding: 2px 7px;
      border-radius: 999px;
      color: #3a2318;
      font-weight:900;
    }

    .kpis{
      display:grid;
      grid-template-columns: repeat(3, 1fr);
      gap:10px;
      padding: 0 16px 14px;
    }
    @media (max-width: 520px){ .kpis{grid-template-columns:1fr} }

    .kpi{
      border: 1px solid rgba(43,26,16,.10);
      background: rgba(255,255,255,.66);
      border-radius: 14px;
      padding: 12px;
    }
    .kpi .label{
      color:var(--muted);
      font-weight:800;
      font-size:12.5px;
    }
    .kpi .value{
      font-size: 24px;
      font-weight:1000;
      margin-top:6px;
      letter-spacing:.2px;
    }
    .kpi.good .value{ color: var(--good); }
    .kpi.bad .value{ color: var(--bad); }

    .split{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap:12px;
      padding: 0 16px 16px;
    }
    @media (max-width: 980px){ .split{grid-template-columns:1fr} }

    .box{
      border:1px solid rgba(43,26,16,.10);
      background: rgba(255,255,255,.55);
      border-radius: 14px;
      padding: 12px;
      min-height: 220px;
    }

    .boxTitle{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin-bottom:10px;
    }
    .boxTitle h3{
      margin:0;
      font-size:13.5px;
      letter-spacing:.2px;
      font-weight:950;
    }

    .pillSmall{
      font-size:12px;
      font-weight:900;
      color: var(--muted);
      border:1px solid rgba(43,26,16,.10);
      background: rgba(255,255,255,.65);
      padding: 6px 10px;
      border-radius: 999px;
    }

    .list{display:flex; flex-direction:column; gap:8px;}

    .rowItem{
      padding: 10px 10px;
      border-radius: 12px;
      border:1px solid rgba(43,26,16,.10);
      background: rgba(255,255,255,.72);
    }
    .rowTop{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin-bottom:6px;
    }

    .badge{
      font-size:12px;
      font-weight:950;
      padding: 6px 10px;
      border-radius: 999px;
      border:1px solid rgba(43,26,16,.10);
      background: rgba(255,255,255,.75);
      color:#2b1a10;
      white-space:nowrap;
    }
    .badge.good{
      border-color: rgba(26,154,83,.25);
      color: var(--good);
      background: rgba(26,154,83,.08);
    }
    .badge.bad{
      border-color: rgba(214,43,58,.25);
      color: var(--bad);
      background: rgba(214,43,58,.07);
    }

    .mono{
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: 12.5px;
      color: #2b1a10;
      word-break: break-word;
      line-height: 1.35;
    }
