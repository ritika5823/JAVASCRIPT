<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Student Task Manager</title>
	<style>
		:root { --bg:#f4f7fb; --card:#fff; --text:#172033; --muted:#64748b; --primary:#2563eb; --border:#dbe3ef; }
		body.dark { --bg:#111827; --card:#1f2937; --text:#f3f4f6; --muted:#cbd5e1; --border:#374151; }
		* { box-sizing:border-box; }
		body { margin:0; font-family:Arial,sans-serif; background:var(--bg); color:var(--text); transition:.2s; }
		main { max-width:850px; margin:35px auto; padding:20px; }
		header { display:flex; justify-content:space-between; align-items:center; gap:15px; margin-bottom:20px; }
		h1 { margin:0 0 6px; } p { color:var(--muted); }
		.card { background:var(--card); border:1px solid var(--border); border-radius:12px; padding:20px; box-shadow:0 5px 18px #0001; }
		form { display:grid; grid-template-columns:1fr 1fr auto; gap:10px; }
		input, select, button { padding:11px; border:1px solid var(--border); border-radius:7px; font:inherit; }
		input, select { background:var(--bg); color:var(--text); }
		button { cursor:pointer; background:var(--primary); color:white; border:0; }
		#themeToggle { background:transparent; color:var(--text); border:1px solid var(--border); }
		ul { list-style:none; padding:0; margin:20px 0 0; }
		li { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px 0; border-bottom:1px solid var(--border); }
		li:last-child { border-bottom:0; } .task-info { flex:1; } .task-info strong { display:block; }
		.done strong { text-decoration:line-through; color:var(--muted); }
		.meta { color:var(--muted); font-size:.85rem; margin-top:5px; }
		.actions { display:flex; gap:7px; } .delete { background:#dc2626; }
		#message { min-height:20px; color:#dc2626; } .empty { text-align:center; color:var(--muted); }
		@media (max-width:600px) { form { grid-template-columns:1fr; } header,li { align-items:flex-start; } li { flex-direction:column; } }
	</style>
</head>
<body>
	<main>
		<header>
			<div><h1>Student Task Manager</h1><p>Organize your assignments and daily goals.</p></div>
			<button id="themeToggle" type="button">🌙 Dark Mode</button>
		</header>
		<section class="card">
			<form id="taskForm">
				<input id="taskInput" type="text" placeholder="Enter a task" maxlength="80" required>
				<select id="priority" aria-label="Task priority"><option>Low</option><option selected>Medium</option><option>High</option></select>
				<button type="submit">Add Task</button>
			</form>
			<div id="message" role="alert"></div>
			<ul id="taskList"></ul>
		</section>
	</main>
	<script>
		const form = document.querySelector('#taskForm'), input = document.querySelector('#taskInput');
		const priority = document.querySelector('#priority'), list = document.querySelector('#taskList');
		let tasks = JSON.parse(localStorage.getItem('studentTasks') || '[]');
		const save = () => localStorage.setItem('studentTasks', JSON.stringify(tasks));
		function render() {
			list.innerHTML = '';
			if (!tasks.length) { list.innerHTML = '<li class="empty">No tasks yet. Add your first task.</li>'; return; }
			tasks.forEach((task, index) => {
				const item = document.createElement('li'); if (task.done) item.className = 'done';
				item.innerHTML = `<div class="task-info"><strong></strong><span class="meta">Priority: ${task.priority}</span></div><div class="actions"><button type="button" class="complete">${task.done ? 'Undo' : 'Done'}</button><button type="button" class="delete">Delete</button></div>`;
				item.querySelector('strong').textContent = task.text;
				item.querySelector('.complete').onclick = () => { tasks[index].done = !tasks[index].done; save(); render(); };
				item.querySelector('.delete').onclick = () => { tasks.splice(index, 1); save(); render(); };
				list.appendChild(item);
			});
		}
		form.onsubmit = event => { event.preventDefault(); const text = input.value.trim();
			if (!text) { document.querySelector('#message').textContent = 'Please enter a task.'; return; }
			tasks.push({ text, priority: priority.value, done: false }); save(); render(); form.reset(); document.querySelector('#message').textContent = ''; input.focus();
		};
		const themeButton = document.querySelector('#themeToggle');
		function setTheme(theme) { document.body.classList.toggle('dark', theme === 'dark'); themeButton.textContent = theme === 'dark' ? '☀️ Light Mode' : '🌙 Dark Mode'; localStorage.setItem('theme', theme); }
		themeButton.onclick = () => setTheme(document.body.classList.contains('dark') ? 'light' : 'dark');
		setTheme(localStorage.getItem('theme') || 'light'); render();
	</script>
</body>
</html>
